{
  "name": "projectriostreamhelper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && python3 -m venv venv && ./venv/bin/pip install -U pip && ./venv/bin/pip install poetry && ./venv/bin/poetry install && npm run build",
    "setup:win": "npm install && python -m venv venv && .\\venv\\Scripts\\pip.exe install -U pip && .\\venv\\Scripts\\pip.exe install poetry && .\\venv\\Scripts\\poetry.exe install && npm run build",
    "dev": "concurrently -n vite,server \"vite\" \"npm run server\"",
    "dev:win": "concurrently -n vite,server \"vite\" \"npm run server:win\"",
    "server": "TSH_DEV=1 ./venv/bin/python3 main.py",
    "server:win": "set TSH_DEV=1 && .\\venv\\Scripts\\python.exe main.py",
    "prebuild": "python3 scripts/freeze-version.py",
    "build": "vite build",
    "vite": "vite",
    "vite:lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "vite:preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mantine/core": "^7.17.0",
    "@mantine/hooks": "^7.17.0",
    "@mantine/notifications": "^7.17.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^9.1.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "ramda": "^0.30.1",
    "react-intl": "^7.1.6",
    "react-router-dom": "^7.2.0",
    "socket.io-client": "^4.8.1",
    "vite": "^6.1.1",
    "vitest": "^4.1.9",
    "zustand": "^5.0.3"
  }
}
